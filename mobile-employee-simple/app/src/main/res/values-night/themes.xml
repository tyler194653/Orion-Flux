<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Mobileemployeesimple" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_secondary</item>
        <item name="colorPrimaryVariant">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_secondary_light</item>
        <item name="colorSecondaryVariant">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Surface and background colors -->
        <item name="android:windowBackground">@color/slate_900</item>
        <item name="colorSurface">@color/slate_800</item>
        <item name="colorOnSurface">@color/slate_50</item>
        <item name="colorOnSurfaceVariant">@color/slate_400</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/slate_900</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>