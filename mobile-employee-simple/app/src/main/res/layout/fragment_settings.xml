<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 语言设置 -->
        <Button
            android:id="@+id/btn_language_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_language"
            android:layout_marginBottom="8dp" />

        <!-- 通知设置 -->
        <Button
            android:id="@+id/btn_notification_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_notification"
            android:layout_marginBottom="8dp" />

        <!-- 隐私设置 -->
        <Button
            android:id="@+id/btn_privacy_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_privacy"
            android:layout_marginBottom="8dp" />

        <!-- 数据同步设置 -->
        <Button
            android:id="@+id/btn_sync_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_sync"
            android:layout_marginBottom="8dp" />

        <!-- 应用信息 -->
        <Button
            android:id="@+id/btn_app_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_app_info"
            android:layout_marginBottom="8dp" />

        <!-- 帮助与反馈 -->
        <Button
            android:id="@+id/btn_help_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_help_feedback"
            android:layout_marginBottom="8dp" />

        <!-- 关于应用 -->
        <Button
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_about"
            android:layout_marginBottom="16dp" />

        <!-- 版本信息 -->
        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_version"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#666666" />

    </LinearLayout>

</ScrollView>